# ============================================================
# .env.example — Template Environment Variables
# Copy file ini jadi .env lalu isi dengan value kamu sendiri
# ============================================================

# Owner Settings (Nomor WhatsApp Owner, contoh: 6281234567890)
OWNER_NUMBER=628xxxxxxxxxx
OWNER_LID=

# Owner tambahan (opsional, pisah pakai koma)
OWNER_NUMBERS=

# Gemini API Keys (bisa 1 atau lebih, pisah pakai koma)
# Daftar di: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=key1,key2,key3
# Satu key saja juga bisa: GEMINI_API_KEY=key1 (dipakai kalau GEMINI_API_KEYS tidak diisi)

# ElevenLabs TTS (opsional - untuk suara AI premium)
# Daftar di: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Perilaku bot (isi 1 untuk aktif, kosongkan untuk nonaktif)
# PROCESS_OWN_COMMANDS: bot memproses perintah dari nomornya sendiri
# DEBUG_INCOMING_MESSAGES: log pesan masuk untuk debugging
PROCESS_OWN_COMMANDS=
DEBUG_INCOMING_MESSAGES=
